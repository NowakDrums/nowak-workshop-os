{
  "rewrites": [
    {
      "source": "/marketing",
      "destination": "/index.html"
    },
    {
      "source": "/marketing/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "installCommand": "npm install --registry=https://registry.npmjs.org --no-audit --no-fund --legacy-peer-deps"
}
